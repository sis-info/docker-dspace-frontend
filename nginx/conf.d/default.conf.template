# Define upstream para el frontend de DSpace
upstream dspace_frontend {
    server frontend-ui:4000;
}

# Configuración para WebSocket connections
map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

# Configuraciones globales de seguridad
# Ocultar información sensible del servidor
server_tokens off;

# Servidor para redirigir todo el tráfico HTTP a HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name ${NGINX_HOST};
    
    # Ocultar información del servidor en errores HTTP
    server_tokens off;
    
    return 301 https://$host$request_uri;
}

# Servidor principal que maneja el tráfico HTTPS
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${NGINX_HOST};
    client_max_body_size 100M;
    
    # Ocultar información del servidor
    server_tokens off;

    # Configuración SSL
    ssl_certificate /etc/nginx/ssl/${NGINX_SSL}/${CRT};
    ssl_certificate_key /etc/nginx/ssl/${NGINX_SSL}/${KEY};
    
    # Configuraciones SSL adicionales
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    
    # Configuración de headers adicionales para mejorar la seguridad

    # Proxy para la interfaz de usuario de DSpace
    # Todas las peticiones irán al contenedor del frontend
    location / {
        proxy_pass http://dspace_frontend;
        proxy_set_header Host localhost;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
        
        # Configuraciones adicionales para Angular
        proxy_redirect off;
        proxy_buffering off;
        proxy_request_buffering off;
        
        # Soporte para WebSocket (Angular Live Reload)
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        
        # Timeouts para Angular
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Configuraciones de seguridad (sin interferir con CORS del backend)
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    
    # CSP más permisivo para evitar conflictos con DSpace
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; style-src-elem 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https: blob:; font-src 'self' data: https:; connect-src 'self' https: wss: ws:; frame-ancestors 'none'; object-src 'none';" always;
    
    # Información del servidor ocultada con server_tokens off
    
    # NO agregar headers CORS aquí - el backend los maneja

    # Páginas de error personalizadas (sin información del servidor)
    error_page 400 401 402 403 404 405 406 407 408 409 410 411 412 413 414 415 416 417 418 421 422 423 424 425 426 428 429 431 451 /error.html;
    error_page 500 501 502 503 504 505 506 507 508 510 511 /error.html;
    
    location = /error.html {
        internal;
        return 200 '<!DOCTYPE html><html><head><meta charset="UTF-8"><title>Error</title></head><body><h1>Se ha producido un error</h1><p>Por favor, inténtelo de nuevo más tarde.</p></body></html>';
        add_header Content-Type text/html;
    }

    # Logs
    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log;
}