# Define upstreams para los servicios de DSpace
upstream dspace_backend {
    server dspace-backend:8080;
}

upstream dspace_frontend {
    server dspace-frontend:4000;
}

# Configuración para WebSocket connections
map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

# Servidor para redirigir todo el tráfico HTTP a HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name ${NGINX_HOST};
    return 301 https://$host$request_uri;
}

# Servidor principal que maneja el tráfico HTTPS
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${NGINX_HOST};
    client_max_body_size 100M;

    # Configuración SSL
    ssl_certificate /etc/nginx/ssl/${NGINX_SSL}/${CRT};
    ssl_certificate_key /etc/nginx/ssl/${NGINX_SSL}/${KEY};
    
    # Configuraciones SSL adicionales
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # Proxy para la API del backend de DSpace
    # Mapear /server/ directamente al backend que mantiene /server/ en su contexto
    location /server/ {
        # No reescribir la URL - DSpace mantiene /server/ en el backend
        proxy_pass http://dspace_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
        
        # Configuraciones adicionales para DSpace
        proxy_redirect off;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 300s;
    }

    # Proxy para la interfaz de usuario de DSpace
    # Todas las demás peticiones irán al contenedor del frontend
    location / {
        proxy_pass http://dspace_frontend;
        proxy_set_header Host localhost;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
        
        # Configuraciones adicionales para Angular
        proxy_redirect off;
        proxy_buffering off;
        proxy_request_buffering off;
        
        # Soporte para WebSocket (Angular Live Reload)
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        
        # Timeouts para Angular
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Configuraciones de seguridad
    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options DENY;
    add_header X-XSS-Protection "1; mode=block";
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Logs
    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log;
}