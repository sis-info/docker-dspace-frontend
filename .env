# ===============================================
# CONFIGURACIÓN DSPACE FRONTEND
# ===============================================

# Configuración del Frontend UI de DSpace Angular
DSPACE_NAME=DSpace Instituto Colombiano de Antropología e Historia
NODE_ENV=production
DSPACE_UI_SSL=false
DSPACE_UI_HOST=0.0.0.0
DSPACE_UI_PORT=4000
DSPACE_UI_NAMESPACE=/

# Configuración de conexión al Backend (en máquina diferente)
# Frontend se conecta al backend externo
DSPACE_REST_SSL=true
DSPACE_REST_HOST=dspace-backend.local
DSPACE_REST_PORT=443
DSPACE_REST_NAMESPACE=/server

# URLs públicas
DSPACE_SERVER_URL=https://dspace-backend.local/server
DSPACE_UI_URL=https://dspace.local

# Configuración interna para SSR (Server-Side Rendering)
# El frontend necesita conectarse directamente al backend durante SSR
DSPACE_REST_INTERNAL_HOST=dspace-backend.local
DSPACE_REST_INTERNAL_PORT=8080
DSPACE_REST_INTERNAL_SSL=false

# Configuración de SSL para Nginx Frontend
NGINX_HOST=dspace.local
NGINX_SSL=dspace.local
CRT=dspace.local.crt
KEY=dspace.local.key

# Configuración adicional del frontend
DSPACE_DEFAULTLANGUAGE=es
DSPACE_CACHE_SERVERSIDE_BOTCACHE_MAX=1000
DSPACE_CACHE_SERVERSIDE_ANONYMOUSCACHE_MAX=1000
DSPACE_AUTH_UI_TIMEUNTIPIDLE=900000